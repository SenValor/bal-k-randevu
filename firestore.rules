rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['baliksefasi33@admin.com', 'bukre@akturk.com'] ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active == true)
      );
    }

    // Rezervasyonlar: okuma API üzerinden (admin SDK), doğrudan erişim kısıtlı
    match /reservations/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // OTP kodları: sadece oluşturulabilir, okunamaz/değiştirilemez
    match /verification_codes/{docId} {
      allow create: if true;
      allow read: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Tekneler — herkes okur, sadece admin yazar
    match /boats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Turlar — herkes okur, sadece admin yazar
    match /tours/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SSS — herkes okur, sadece admin yazar
    match /faq/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Galeri — herkes okur, sadece admin yazar
    match /gallery/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Duyurular — herkes okur, sadece admin yazar
    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Promo kodlar — herkes okur (doğrulama için), sadece admin yazar
    match /promoCodes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koltuk kilitleme — sadece giriş yapmış kullanıcılar yazabilir
    match /seatLocks/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Kara liste — sadece admin
    match /blacklist/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Kullanıcılar — kendi verisini okuyup yazabilir, admin her şeye erişir
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Admin listesi
    match /admins/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Admin logları — sadece adminler
    match /adminLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }
  }
}
